{
  "rules": {
    ".read": false,
    ".write": false,
    "livelearn": {
      "classes": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$classe": {
          ".read": "auth != null"
        }
      },
      "students": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$codice": {
          ".read": "auth != null"
        }
      },
      "sessions": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".indexOn": [
          "createdAt",
          "status"
        ],
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "quotaAlert": {
            ".write": "auth != null"
          }
        }
      },
      "inbox": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$sessione": {
          "$alunno": {
            ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
          }
        }
      },
      "responses": {
        "$code": {
          ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "$alunno": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === 'UID-DELLA-DOCENTE' || !data.exists() || !data.child('uid').exists() || data.child('uid').val() === auth.uid)"
          }
        }
      },
      "rank": {
        "$code": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null"
          }
        }
      },
      "control": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "history_priv": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$codice": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "activities": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "activityIndex": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
      },
      "agentPing": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".validate": "newData.isNumber()"
      },
      "versionKeys": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
      },
      "board": {
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "$msg": {
            "readBy": {
              "$codice": {
                ".write": "auth != null",
                ".validate": "newData.isBoolean()"
              }
            }
          }
        }
      },
      "board_priv": {
        "$classe": {
          ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "$codice": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
            "$msg": {
              ".write": "auth != null && !data.exists() && newData.child('from').val() === 'student'",
              "readBy": {
                "$x": {
                  ".write": "auth != null",
                  ".validate": "newData.isBoolean()"
                }
              }
            }
          }
        }
      },
      "lessons": {
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "agentDone": {
        "$classe": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "fcmTokens": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$classe": {
          "$codice": {
            ".write": "auth != null"
          }
        }
      },
      "recovery_sessions": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        "$codice": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "$piano": {
            "lastScore": {
              ".write": "auth != null && data.parent().exists()"
            },
            "attemptCount": {
              ".write": "auth != null && data.parent().exists()"
            },
            "lastAttemptAt": {
              ".write": "auth != null && data.parent().exists()"
            },
            "status": {
              ".write": "auth != null && data.parent().exists()"
            },
            "bestScore": {
              ".write": "auth != null && data.parent().exists()"
            },
            "bestAttempt": {
              ".write": "auth != null && data.parent().exists()"
            },
            "attempts": {
              "$n": {
                ".write": "auth != null && data.parent().parent().exists() && !data.exists()"
              }
            }
          }
        }
      },
      "planDrafts": {
        ".read": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
        ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
      },
      "recovery_lookup": {
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'"
        }
      },
      "aiRequests": {
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "aiResponses": {
        "$id": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'UID-DELLA-DOCENTE'",
          "$rid": {
            ".write": "auth != null && !newData.exists()"
          }
        }
      }
    }
  }
}
